# Public build-time API origin; do not put tokens or other secrets here.
VITE_API_BASE_URL=https://api.example.com/api/v1
# Backend only: comma-separated frontend origins, e.g. https://gmi.example.com
GMI_CORS_ORIGINS=https://gmi.example.com
# Optional backend-only Telegram notifications. Keep actual credentials out of Git.
GMI_TELEGRAM_BOT_TOKEN=
# One or more chat IDs, separated by commas (or newlines in the environment).
GMI_TELEGRAM_CHAT_ID=
